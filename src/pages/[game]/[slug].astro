---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const guides = await getCollection("guides", ({ data }) => !data.draft);

  return guides.map((guide) => ({
    params: {
      game: guide.data.game,
      slug: guide.data.slug,
    },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
---

<html>
<head>
<title>{guide.data.title} | GuideAnvil</title>
<meta name="description" content={guide.data.description} />
</head>

<body style="font-family: sans-serif; max-width: 800px; margin:auto; padding:40px">

<a href="/">Home</a>

<h1>{guide.data.title}</h1>
<p>{guide.data.description}</p>

<Content />

</body>
</html>
