---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const guides = await getCollection("guides", ({ data }) => !data.draft);

  return guides.map((guide) => {
    const relatedGuides = guides.filter(
      (g) => g.data.game === guide.data.game && g.data.slug !== guide.data.slug
    );

    return {
      params: {
        game: guide.data.game,
        slug: guide.data.slug,
      },
      props: { guide, relatedGuides },
    };
  });
}

const { guide, relatedGuides } = Astro.props;
const { Content } = await render(guide);

const prettyGameName = guide.data.game
  .split("-")
  .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
  .join(" ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{guide.data.title} | GuideAnvil</title>
    <meta name="description" content={guide.data.description} />
  </head>
  <body style="font-family: Arial, sans-serif; max-width: 800px; margin: auto; padding: 40px;">
    <nav>
      <a href="/">Home</a> /
      <a href={`/${guide.data.game}`}>{prettyGameName}</a>
    </nav>

    <h1>{guide.data.title}</h1>
    <p>{guide.data.description}</p>

    <div style="color: #666; font-size: 14px; margin-bottom: 20px;">
      Category: {guide.data.category}<br />
      Published: {guide.data.pubDate.toISOString().slice(0, 10)}
      {guide.data.updatedDate && (
        <>
          <br />
          Updated: {guide.data.updatedDate.toISOString().slice(0, 10)}
        </>
      )}
    </div>

    <hr />

    <article>
      <Content />
    </article>

    <hr />

    <h3>Tags</h3>
    <ul>
      {guide.data.tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>

    <hr />

    <h3>Related Guides</h3>
    <ul>
      {relatedGuides.slice(0, 5).map((related) => (
        <li>
          <a href={`/${related.data.game}/${related.data.slug}`}>
            {related.data.title}
          </a>
        </li>
      ))}
    </ul>
  </body>
</html>
