---
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const guides = await getCollection("guides", ({ data }) => !data.draft);

  return guides.map((guide) => ({
    params: {
      slug: guide.slug,
    },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await guide.render();
---

<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<title>{guide.data.title} | GuideAnvil</title>
<meta name="description" content={guide.data.description} />
</head>

<body style="font-family: sans-serif; max-width: 900px; margin: auto; padding: 40px;">
<a href="/">← Back</a>

<h1>{guide.data.title}</h1>
<p>{guide.data.description}</p>

<Content />

</body>
</html>
