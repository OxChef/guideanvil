---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const guides = await getCollection("guides", ({ data }) => !data.draft);

  return guides.map((guide) => ({
    params: {
      slug: guide.id,
    },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{guide.data.title} | GuideAnvil</title>
    <meta name="description" content={guide.data.description} />
  </head>
  <body style="font-family: Arial, sans-serif; max-width: 800px; margin: 0 auto; padding: 2rem;">
    <p><a href="/">Back to home</a></p>
    <h1>{guide.data.title}</h1>
    <p>{guide.data.description}</p>
    <hr />
    <article>
      <Content />
    </article>
  </body>
</html>
